---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PublishedContentBody from '@treeseed/ui/components/astro/site/PublishedContentBody.astro';
import RouteNotFound from '@treeseed/ui/components/astro/site/RouteNotFound.astro';
import CoreStyleScope from '../../../../../layouts/CoreStyleScope.astro';
import { loadPublishedEntry } from '../../../../../utils/content/site-content-runtime.ts';
import { bookSidebar, canReadKnowledge, loadFederatedReader, loadReaderLibrary, pagesForBook, starlightKnowledgeFrontmatter } from '../../../../../utils/knowledge/reader-library.ts';

export const prerender = false;

const teamSlug = String(Astro.params.teamSlug ?? '');
const bookSlug = String(Astro.params.bookSlug ?? '');
const pageSlug = String(Astro.params.pageSlug ?? '').replace(/^\/+|\/+$/gu, '');
const federated = await loadFederatedReader(Astro.locals, { teamSlug, bookSlug, pageSlug }).catch(() => ({ unavailable: true }));
const useLocalLibrary = federated === null;
const library = federated?.book ? federated : useLocalLibrary ? await loadReaderLibrary(Astro.locals) : { published: false, books: [], pages: [] };
const book = federated?.book ?? library.books.find((candidate) => candidate.data.slug === bookSlug && candidate.data.status === 'published'
	&& canReadKnowledge(Astro.locals, String(candidate.data.visibility))) ?? null;
const pages = federated?.book ? federated.pages : book ? pagesForBook(library.pages, String(book.data.id)).filter((candidate) => canReadKnowledge(Astro.locals, String(candidate.data.visibility))) : [];
const page = federated?.page ?? pages.find((candidate) => candidate.data.slug === pageSlug) ?? null;
const content = !federated?.book && !library.published && page ? await import('astro:content') : null;
const localEntry = content && page ? (await content.getCollection('docs')).find((entry: any) => entry.id === page.id) ?? null : null;
const rendered = localEntry ? await content?.render(localEntry) : null;
const Content = rendered?.Content ?? null;
const published = federated?.page ? { html: federated.page.data.bodyHtml } : library.published && page ? await loadPublishedEntry(Astro.locals, 'docs', page.id) : null;
if ((federated as any)?.unavailable) Astro.response.status = 503;
else if (!book || !page || (!federated?.book && teamSlug !== 'treeseed')) Astro.response.status = 404;
---


<CoreStyleScope>
{!book || !page ? (
	<RouteNotFound title={(federated as any)?.unavailable ? 'Knowledge unavailable' : 'Knowledge page not found'} description={(federated as any)?.unavailable ? 'The published knowledge runtime could not be loaded. Retry after it recovers.' : 'This page is unavailable or you do not have access to it.'} currentPath="/books/" />
) : (
	<StarlightPage
		frontmatter={starlightKnowledgeFrontmatter(page.data)}
		sidebar={bookSidebar(teamSlug, book, pages)}
		headings={rendered?.headings ?? []}
	>
		{published?.html ? <PublishedContentBody html={published.html} /> : Content ? <Content /> : <p>This page could not be rendered.</p>}
	</StarlightPage>
)}
</CoreStyleScope>
